.claude/settings.local.json

# 로컬 Claude 세션·잡 데이터 전체
.claude/

# make_readme_media 의 실데이터 애니메이션 — 5MB 대라 README 에 안 쓰고 커밋도 안 한다
# (README 가 쓰는 개념 데모는 docs/img/demo_bridge.gif, make_demo_preview.py 산출)
docs/img/demo.gif

# configs/ 는 **입력**만 추적한다. 아래는 --make-sarvey-config 생성물이라 입력에서
# 언제든 재생성되고, 커밋해 두면 입력과 어긋난 채 남아 오해를 부른다.
configs/*/processing_manifest.json
configs/*/sarvey_config.json

# 벤치 산출물(스크립트는 scripts/bench, 결과는 재생성)
data/bench/

# 실 처리 부산물 — ISCE2 로그·SLC 경로 목록(WSL 실경로, 재생성됨)
isce.log
*.isce.log
SAFE_files.txt

# 파트너 전달본(스마트인사이드에이아이 pontifex) — 남의 코드다. 공개 저장소에 올리지 않는다.
pontifex-*.tar.gz
pontifex-*/

# 재처리 대상 스택 — PC 마다 경로가 다르다(.example 만 저장소에)
configs/rerun_stacks.json

# 파트너 제공 교량 제원 CSV(스마트인사이드에이아이) — 남의 데이터다
data/bridges_load.csv
data/bridges_specs.csv

# 한 번에 시작(start.py)이 만드는 가상환경·데모 산출물
.venv/
demo.h5

# bridge_run 중간 산출물(재생성 가능) — 저장소에 넣지 않는다
docs/bridges/*/track_deck.h5
docs/bridges/*/track_rh_full.h5
docs/bridges/*/project.h5
docs/bridges/*/pipeline/
inframon_handoff_*.zip

# 파이프라인 임시 산출(재현 가능 · 커밋하지 않는다)
out/

# 실화면 영상 만들 때 쓰는 중간 산출물(실제 clone·venv·녹화 webm)
.demo_capture/

# 파워포인트 임시 잠금 파일
~$*

# 교량 폴더 통째 압축본(수십 GB) — 저장소에 넣지 않는다
docs/bridges/*.zip

# 참고용으로 받아 둔 남의 발표자료 — 250 MB 라 리포에 넣지 않는다(GitHub 100 MB 제한)
# KAIA 자문회의 원본 자료(제3자·수백 MB) — 판마다 새 이름으로 들어와서
# v2 만 막아 두면 v11 같은 새 판이 그대로 딸려 들어간다. 이름 전체를 막는다.
docs/2026 KAIA 자문회의*.pptx

# 손으로 고친 7p 사본(_로고수정 · _찐찐 · _찐찐_song …) — 저장할 때마다
# 12~26 MB 가 통째로 쌓인다. 리포에는 생성 경로(7p_1 · 7p_vF)만 둔다.
docs/KICT_Bmaps_Inframon_연구개발_7p_vF_*.pptx
